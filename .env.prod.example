# Production env — set these in Dokploy → Environment for the lapse-api project.
# DO NOT commit a real .env.prod.

NODE_ENV=production
PORT=3000

# Postgres
POSTGRES_PASSWORD=replace-with-strong-random-string

# Auth — generate two long random strings (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=replace-with-a-64-hex-string
JWT_REFRESH_SECRET=replace-with-another-64-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DEFAULT=7d
JWT_REFRESH_TTL_STAY=90d

# CORS — list every origin that should be allowed to call the API.
# Comma-separated. Capacitor and Tauri use these specific origins:
#   - capacitor://localhost      (iOS)
#   - http://localhost           (Android via local scheme)
#   - https://lapse.cecko.dev    (web)
#   - tauri://localhost          (macOS — Tauri WebKit)
CORS_ORIGINS=https://lapse.cecko.dev,capacitor://localhost,http://localhost,tauri://localhost

APP_URL=https://lapse.cecko.dev

# Sentry — error tracking. Leave blank to disable.
SENTRY_DSN=
